vbH = 260;\n    var inner = '';\n return svgRoot('positionGrid', opts, 720, 260, 'Position Grid', 'Standard field positions', inner);\n  };\n\n  var drawSwingSequence = function(opts) {\n    opts = extend({highlight: null, order: null, showLabels: true, hotspots: []}, opts);\n    var vbW = 900;\n    var vbH = 260;\n    var inner = '';\n    return svgRoot('swingSequence', opts, 900, 260, 'Swing Sequence', 'Swing mechanics frames', inner);\n  };\n\n  var drawThrowSequence = function(opts) {\n    opts = extend({highlight : null, order: null, showGrip: true, hotspots: []}, opts);\n    var vbW = 900;\n    var vbH = 260;\n    var inner = '';\n    return svgRoot('throwSequence', opts, 900, 260, 'Throw Sequence', 'Throw mechanics frames ', inner);\n  };\n\n  var drawCountMatrix = function(opts) {\n    opts = extend({highlight: null, shade: null, hotspots: []}, opts);\n    var vbW = 560;\n    var vbH = 420;\n    var inner = '';\n    return svgRoot('countMatrix', opts , 560, 420, 'Count Matrix', 'Count situations', inner);\n  };\n\n  var drawSprayChart = function(opts) {\n    opts = extend({points: [], showZones: true, hotspots: []}, opts);\n    var vbW = 700;\n    var vbH = 620 ;\n    var inner = '';\n    return svgRoot('sprayChart', opts, 700, 620, 'Spray Chart', 'Batted ball locations', inner);\n  };\n\n  var drawScaleGauge = function(opts) {\n    opts = extend({value: 50, compare: null, label: null, hotspots: []}, opts);\n    var vbW = 640;\n    var vbH = 220;\n    var inner = '';\n    return svgRoot('scaleGauge', opts, 640, 220, 'Scale Gauge', 'Scouting scale', inner);\n  };\n\n  var drawRadar = function (opts) {\n    opts = extend({topics: [], rings: 4, showValues: true, hotspots: []}, opts);\n    var vbW = 520;\n    var vbH = 520;\n    var inner = '';\n    return svgRoot('radar', opts, 520, 520, 'Radar Chart', 'BBIQ topic breakdown', inner);\n  };\n\n  var drawBar = function(opts) {\n    opts = extend({series: [], max: null, unit: '', sort: true, hotspots: []}, opts);\