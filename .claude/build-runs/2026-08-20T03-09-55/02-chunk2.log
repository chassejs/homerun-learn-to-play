  "thought": "The user wants me to implement `svg.js` for the Homerun Learn to Play project. There are very strict constraints:\nLet me continue reading more of the BUILD-PLAN for svg.js specifics, plus index.html, styles.css, and check if there's already a tests folder or existing svg.js. Also look at more of the BUILD-PLAN ar...Let me read more of the BUILD-PLAN around the svg section and also the styles.css SVG-related classes. Also look at sibling apps for existing SVG patterns.Let me look at the sibling baseball-app for field drawing patterns that I can learn from. Also check if there's more detail in the BUILD-PLAN about field alignments.\n/* ===================================================================\n   Homerun Learn to Play — svg.js\n   Pure SVG string builders for Homerun Learn to Play curriculum\n   =================================================================== */\n\nvar root = typeof window !== 'undefined' ? window : this;\n\nvar HRL_SVG = (function() {\n  'use strict';\n\n  var counter =  0;\n  var esc = function(str) {\n    return String(str)\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;')\n      . replace(/'/g, '&#39;');\n  };\n\n  var extend = function(obj1, obj2) {\n    var out = {};\n    for (var k in obj1) out[k] = obj1[k];\n    for (var k in obj2) out[k] = obj2[k];\n    return out;\n  };\n\n  var nextId = function(prefix) {\n    counter++;\n    return 'hrl-svg-' + counter + '-' + prefix;\n  };\n\n  var hotspotLabel = function(id) {\n    var map = {\n      'p': 'Pitcher',\n      'c': 'Catcher',\n      ' 1b': 'First Base',\n      '2b': 'Second Base',\n      '3b': 'Third Base',\n      'ss': 'Shortstop',\n      'lf': 'Left Fielder',\n      'cf': 'Center Fielder',\n      'rf': 'Right Fielder',\n      'home': 'Home Plate',\n      'first': 'First Base',\n      'second': 'Second Base',\n      'third': 'Third Base',\n      'mound': 'Pitching Mound',\n      'plate': 'Home Plate',\n      'infield': 'Infield',\n      'outfield': 'Outfield ',\n      'foul-left': 'Foul Line Left',\n      'foul-right': 'Foul Line Right',\n      'fair-territory': 'Fair Territory',\n      'warning-track': 'Warning Track',\n      'backstop': 'Backstop',\n      'batter-box-left': 'Left Batter Box',\n      'batter-box-right': 'Right Batter Box',\n      'catcher-box': 'Catcher Box',\n      'on-deck-left': 'On-Deck Left',\n      'on-deck-right': 'On-Deck Right',\n      'coach-box-first': 'Coach Box First',\n      'coach -box-third': 'Coach Box Third',\n      'dugout-home': 'Home Dugout',\n      'dugout-away': 'Away Dugout',\n      'baseline-first': 'First Baseline',\n      'baseline-second': 'Second Baseline',\n      'baseline-third': 'Third Baseline',\n      'baseline-home ': 'Home Baseline',\n      'foul-pole-left': 'Left Foul Pole',\n      'foul-pole-right': 'Right Foul Pole',\n      'outfield-fence': 'Outfield Fence',\n      'zone-1': 'Zone 1',\n      'zone-2': 'Zone 2 ',\n      'zone-3': 'Zone 3',\n      'zone-4': 'Zone 4',\n      'zone-5': 'Zone 5',\n      'zone-6': 'Zone 6',\n      'zone-7': 'Zone 7',\n      'zone-8': 'Zone 8',\n      'zone-9': 'Zone 9',\n      'zone-out-high': 'High Outside',\n      'zone-out-low': 'Low Outside',\n      'zone-out-in': 'Inside',\n      'zone-out-away': 'Away'\n    };\n    return map[id] || id;\n  };\n\n  var positionName = function(id) {\n    var map = {\n      'p': 'Pitcher',\n      'c': 'Catcher',\n      '1b': 'First Baseman',\n      '2b': 'Second Baseman',\n      '3b': 'Third Baseman',\n      'ss': ' Shortstop',\n      'lf': 'Left Fielder',\n      'cf': 'Center Fielder',\n      'rf': 'Right Fielder'\n    };\n    return map[id] || id;\n  };\n\n  var positionNumber = function(id) {\n    var nums = {\n      'p': 1,\n      'c': 2,\n      '1b': 3,\n      '2b': 4,\n      '3b': 5,\n      'ss': 6,\n      'lf': 7,\n      'cf': 8,\n      'rf': 9\n    };\n    return nums[id ] || 0;\n  };\n\n  var FIELD_PARTS = [\n    'home', 'first', 'second', 'third', 'mound', 'plate', 'infield', 'outfield',\n    'foul-left', 'foul-right', 'fair-territory', 'warning-track', ' backstop',\n    'batter-box-left', 'batter-box-right', 'catcher-box', 'on-deck-left',\n    'on-deck-right', 'coach-box-first', 'coach-box-third', 'dugout-home',\n    'dugout-away', 'baseline-first', 'baseline-second', 'baseline-third',\n    'baseline-home', 'foul-pole-left', 'foul-pole-right', 'outfield-fence'\n  ];\n\n  var ZONE_CELLS = [\n    'zone-1', 'zone-2', 'zone-3', 'zone-4', 'zone-5 ',\n    'zone-6', 'zone-7', 'zone-8', 'zone-9',\n    'zone-out-high', 'zone-out-low', 'zone-out-in', 'zone-out-away'\n  ];\n\n  var SWING_FRAMES = ['frame-stance', 'frame-load', 'frame-str ide', 'frame-contact', 'frame-finish'];\n  var THROW_FRAMES = ['frame-grip', 'frame-separation', 'frame-stride', 'frame-release', 'frame-follow-through'];\n  var COUNT_CELLS = [\n    'count-0-0', 'count-0-1 ', 'count-0-2', 'count-1-0', 'count-1-1',\n    'count-1-2', 'count-2-0', 'count-2-1', 'count-2-2', 'count-3-0',\n    'count-3- 1', 'count-3-2'\n  ];\n\n  var BUILDERS = [\n    'field', 'strikeZone', 'basePaths', 'positionGrid', 'swingSequence',\n    'throwSequence', 'countMatrix', 'sprayChart', 'scaleGauge', 'radar',\n    'bar', 'timeline '\n  ];\n\n  var FIELD_DIMENSIONS = {\n    't-ball': {bases: 60, mound: 40, label: 'T-ball (BQ 11U Class B pitching)'},\n    'minor': {bases: 60, mound: 46, label: 'Minor (LL Tee Ball 60/46)'},\n    'major-ll': {bases: 60, mound: 46, label: 'Major LL (LL Major 60/46)'},\n    'intermediate': {bases: 70, mound: 50, label: 'Intermediate (LL 70/50)'},\n    'junior': {bases: 80, mound: 54, label: 'Junior (LL 80/54)'},\n    'full': {bases: 90, mound: 60.5, label: 'Full (LL Junior/Senior 90/60.5)'}\n  };\n\n  var svgRoot = function(builderName, opts, vbW, vbH, defaultTitle, defaultDesc, inner) {\n    opts = opts || {};\n    var id = nextId('root');\n    var tid = id + '-t';\n    var did = id + '-d';\n    var width = opts.width 