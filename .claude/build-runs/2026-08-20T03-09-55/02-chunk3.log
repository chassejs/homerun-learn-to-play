  "thought": "The user wants me to implement Chunk 3 of 9 - `progress.js` and `shell.js` for the Homerun Learn to Play app. There are very strict constraints:\nGood, I have the BUILD-PLAN. Now I need to read all the existing files mentioned in the brief:I need to read styles.css for class names related to progress bars, toasts, settings, empty states, etc. Also look at sibling apps for progress/shell patterns. The versionCompat.js does NOT have `prep...I need to read styles.css for class names related to progress bars, toasts, settings, empty states, etc. Also look at sibling apps for progress/shell patterns. The versionCompat.js does NOT have `prepareImport()` - the BUILD-PLAN mentions it but the actual file has:\n- compareVersions\n- is ImportCompatible\n- applyMigrations\n- _MIGRATIONS\n- _BREAKING_BOUNDARIES\n- _buildMigrationPath\n\nThe brief says:\n> `importPayload(obj)` → validates through `HRL_VERSION_COMPAT` (use its real API — read `versionCompat.Let me read the practice app's versionCompat.js to see if it has prepareImport, and also read relevant CSS classes in more detail. Also look at practice app's shell.js for patterns.Let me look at more CSS for ring, settings, help, and also look at practice-app shell.js for patterns. Also check if there's a VERSIONING.md in this project, and look at styles for toast kinds (info/s...Let me look at more CSS for tier-ring, toast kinds, form controls, and also check if there's any existing chunk 3 work or tests. Also look at styles for field/label/checkbox.\nLet me look at more of the CSS around views, and also look at svg.js for radar/bar if I need a completion ring. The brief says:\nI’ve reviewed the CSS for toast variants and the tier-ring SVG patterns in svg.js. The `.Let me also look at how svg.js exports for Node, and look at scaleGauge or similar for the ring. I have enough context to implement.\n```js\n// progress.js\nvar root = typeof window !== 'undefined' ? window : this;\n\nvar STORAGE_KEY = 'homerun-learn/progress/v1';\nvar storageAvailable = false;\nvar memoryStore = null;\nvar state = null;\n\nfunction probeStorage() {\n  try {\n    if (typeof local Storage === 'undefined') return false;\n    var testKey = STORAGE_KEY + '/probe';\n    localStorage.setItem(testKey, '1');\n    localStorage.removeItem(testKey);\n    return true;\n  } catch (e) {\n    return false;\n  }\n}\n\nfunction dataVersion() {\n  var v = root.HRL_VERSION;\n  return (v && v.DATA_VERSION) ? v.DATA_VERSION : '1.0';\n}\n\nfunction appVersion() {\n  var v = root.HRL_VERSION;\n  return (v && v.APP_VERSION) ? v.APP_VERSION : '1.0';\n}\n\nfunction defaultState() {\n  return {\n    version: dataVersion(),\n    placement: {\n      done: false,\n      recommendedTier: 1,\n      role: null,\n      goal: null,\n      experience: null,\n      theta: 0,\n      takenAt: null\n    },\n    chapters: {},\n    badges: [],\n    review: [],\n    iq: { attempts: [], best: null },\n    streak: { current: 0, longest: 0, lastActiveDay: null },\n    settings: { timerEnabled: true, reducedMotion: false, textSize: 'normal' }\n  };\n}\n\nfunction defaultChapter() {\n  return {\n     visited: false,\n     completed: false,\n     bestScore: 0,\n     attempts: 0,\n     completedAt: null,\n     lastSeenAt: null\n   };\n}\n\nfunction extend(target, source) {\n  var k;\n  if (!source) return target;\n  for (k in source) {\n    if (Object.prototype.hasOwnProperty.call(source, k)) {\n      target[k] = source[k];\n    }\n  }\n  return target;\n}\n\nfunction clone(obj) {\n  return JSON.parse(JSON.stringify(obj));\n}\n\nfunction getCurriculum() {\n  return root.HRL_CURRICULUM || null;\n}\n\nfunction allChapters() {\n  var cur = getCurriculum();\n  if (!cur || !cur.chapters || !cur.chapters.length) return [];\n  return cur.chapters;\n}\n\nfunction chaptersForTier(tierKey) {\n  var list = allChapters();\n  var out = [];\n  var i , ch;\n  for (i = 0; i < list.length; i++) {\n    ch = list[i];\n    if (ch && ch.tier === tierKey) out.push(ch);\n  }\n  return out;\n}\n\nfunction ensureChapter(chapterId) {\n  if (!state.chapters[chapter Id]) {\n    state.chapters[chapterId] = clone(defaultChapter());\n  }\n  return state.chapters[chapterId];\n}\n\nfunction save() {\n  if (memoryStore !== null) {\n    memoryStore.state = clone(state);\n    return true;\n  }\n  if (storageAvailable) {\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n      return true;\n    } catch (e) {\n      return false;\n    }\n  }\n  return false;\n}\n\nfunction load() {\n  if (memoryStore !== null) {\n    state = clone(memoryStore.state);\n    return state;\n  }\n  if (storageAvailable) {\n    try {\n      var raw = localStorage.getItem(STORAGE_KEY);\n      if (raw) {\n        var loaded = JSON.parse(raw);\n        state = fillDefaults(loaded);\n      } else {\n        state = clone(defaultState());\n      }\n      return state;\n    } catch (e) {\n      state = clone(defaultState());\n      return state;\n    }\n  }\n  state = clone(defaultState());\n  return state;\n}\n\nfunction fillDefaults(raw) {\n  var def = defaultState();\n  if (!raw || typeof raw !== 'object') return clone(def);\n  var out = clone(def);\n  extend(out, raw);\n  if (raw.chapters) {\n    var chs = out.chapters;\n    for (var id in raw.chapters) {\n      if (Object.prototype.hasOwnProperty.call(raw.chapters, id)) {\n        chs[id] = extend(clone(defaultChapter ()), raw.chapters[id]);\n      }\n    }\n  }\n  return out;\n}\n\nfunction get() {\n  return state;\n}\n\nfunction reset() {\n  state = clone(defaultState());\n  save();\n  return true;\n}\n\nfunction storageAvailable() {\n  return storageAvailable;\n}\n\nfunction isFirstRun() {\n  if (state.placement && state.placement.done) return false;\n   var ch = state.chapters || {};\n   var id;\n   for (id in ch) {\n     if (Object.prototype.hasOwnProperty.call(ch, id) && ch[id] && ch[id].visited) {\n       return false;\n     }\n   }\n   return true;\n}\n\nfunction setPlacement(obj) {\n  obj = obj || {};\n  var p = state.placement;\n  if (obj.recommendedTier != null) p.recommendedTier = obj.recommendedTier;\n  if (obj.role !== undefined) p.role = obj.role;\n  if (obj.goal !== undefined) p.goal = obj.goal;\n  if (obj.experience !== undefined) p.experience = obj.experience;\n  if (obj.theta !== undefined) p.theta = obj.theta;\n  p.done = true;\n  p.takenAt = new Date().toISOString();\n  save();\n return true;\n}\n\nfunction getPlacement() {\n  return state.placement;\n}\n\nfunction markVisited(chapterId) {\n  var rec = ensureChapter(chapterId);\n  rec.visited = true;\n  rec.lastSeenAt = new Date().toISOString();\n  save();\n  return true;\n}\n\nfunction recordQuiz (chapterId, scorePct, passed) {\n  var rec = ensureChapter(chapterId);\n  rec.attempts = (rec.attempts || 0) + 1;\n  if (typeof scorePct === 'number' && scorePct > (rec.bestScore || 0)) {\n    rec .bestScore = scorePct;\n  }\n  var newlyCompleted = false;\n  var badgesAwarded = [];\n  if (passed) {\n    if (!rec.completed) {\n      rec.completed = true;\n      rec.completedAt = new Date().toISOString();\n      newlyCompleted = true;\n    }\n    rec.completed = true;\n    if (awardBadge('chapter-' + chapterId)) {\n      badgesAwarded.push('chapter-' + chapterId);\n    }\n  }\n  if (scorePct === 100) {\n    if (awardBadge('perfect-quiz')) badgesAwarded.push('perfect-quiz');\n  }\n  var tierBadges = checkTierBadges();\n   badgesAwarded = badgesAwarded.concat(tierBadges);\n  save();\n  return {\n    bestScore: rec.bestScore,\n    completed: rec.completed,\n    newlyCompleted: newlyCompleted,\n    badgesAwarded: badgesAwarded\n  };\n}\n\nfunction getChapter(chapterId) {\n  var rec = state.chapters[chapterId];\n  if (!rec) return clone(defaultChapter());\n  return clone(rec);\n}\n\nfunction isComplete(chapterId) {\n  var rec = getChapter(chapterId);\n  return rec.completed;\n}\n\nfunction tierProgress(tierKey ) {\n  var list = chaptersForTier(tierKey);\n  if (!list.length) return { total: 0, complete: 0, pct: 0 };\n  var total = list.length;\n  var complete = 0;\n  var i;\n  for (i = 0; i < list.length; i++) {\n    if (list[i] && list[i].completed) complete++;\n  }\n  return {\n    total: total,\n    complete: complete,\n    pct: total ? Math.round((complete / total) * 100) : 0\n  };\n}\n\nfunction overallProgress() {\n  var list = allChapters();\n   if (!list.length) return { total: 0, complete: 0, pct: 0 };\n   var total = list.length;\n   var complete = 0;\n   var i;\n   for (i = 0; i < list.length; i++) {\n     if (list[i] && list[i].completed) complete++;\n   }\n   return {\n     total: total,\n     complete: complete,\n     pct: total ? Math.round((complete / total) * 100) : 0\n   };\n}\n\nfunction nextChapter() {\n  var placement = state.placement;\n var recTier = placement.recommendedTier || 1;\n  var cur = getCurriculum();\n  if (!cur || !cur.chapters || !cur.chapters.length) return null;\n  var list = cur.chapters;\n  var startIdx = -1;\n  for (var i = 0; i < list.length; i++) {\n    if (list[i].tier === recTier) {\n      startIdx = i;\n      break;\n    }\n  }\n  if (startIdx === -1) startIdx = 0;\n  for (var j = startIdx; j < list.length; j++) {\n var ch = list[j];\n    if (ch && !ch.completed) return ch.id;\n  }\n  for (var k = 0; k < list.length; k++) {\n    var ch2 = list[k];\n    if (ch2 && !ch2.completed) return ch2.id;\n  }\n return null;\n}\n\nvar BOX_INTERVALS = [1, 3, 7, 16, 35];\n\nfunction findReview(qid) {\n  var review = state.review || [];\n  var i;\n  for (i = 0; i < review.length; i++) {\n    if (review[i ].qid === qid) return review[i];\n  }\n  return null;\n}\n\nfunction removeReview(qid) {\n  var review = state.review || [];\n  var i;\n  for (i = 0; i < review.length; i++) {\n    if (review[i].qid === qid ) {\n      review.splice(i, 1);\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction addMiss(qid, nowMs) {\n  var entry = findReview(qid);\n  if (entry) {\n    entry.box = 1;\n    entry.dueAt = nowMs + 86400000;