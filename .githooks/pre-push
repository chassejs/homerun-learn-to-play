#!/bin/sh
# ===================================================================
# Homerun Learn to Play — .githooks/pre-push
#
# Gates the DEPLOY branch, not main.
#
# Netlify's production branch for this site is `deploy`. Pushing to
# `main` publishes nothing, so day-to-day work is free and unguarded.
# Promoting to `deploy` is the deploy gesture:
#
#     git push origin main:deploy
#
# That push is the metered, user-visible act, so it is the one worth
# gating. This hook refuses a promotion that either:
#
#   1. fails preflight (scripts/preflight.mjs), or
#   2. does not increase APP_VERSION over what is already deployed.
#
# Why a check rather than an automatic bump: git has already decided
# which refs to send by the time pre-push runs, so a commit created
# here would sit unpushed and the very next push would fail. The hook
# blocks; `npm run bump` (or `npm run bump:major`) does the edit.
#
# Installed via core.hooksPath (set by the `prepare` npm script).
# To wire it up by hand: git config core.hooksPath .githooks
# ===================================================================

ZERO='0000000000000000000000000000000000000000'
VERSION_FILE='version.js'
DEPLOY_REF='refs/heads/deploy'

# Read `var APP_VERSION = '<major>.<minor>';` from the committed file.
# Exactly two spaces of indent — the same shape the bump script writes
# and that tests/version.test.js asserts — so comment examples cannot match.
version_at() {
  blob=$(git show "$1:$VERSION_FILE" 2>/dev/null) || return 1
  value=$(printf '%s' "$blob" | sed -n "s/^  var APP_VERSION = '\([0-9][0-9]*\.[0-9][0-9]*\)';.*/\1/p" | head -n 1)
  [ -z "$value" ] && return 1
  printf '%s' "$value"
}

# True (exit 0) if version $1 is strictly greater than version $2, comparing
# major and minor as integers — not floats, so 1.10 correctly beats 1.9.
version_gt() {
  awk -v a="$1" -v b="$2" '
    BEGIN {
      split(a, av, "."); split(b, bv, ".");
      if (av[1]+0 != bv[1]+0) { exit !(av[1]+0 > bv[1]+0) }
      exit !(av[2]+0 > bv[2]+0)
    }'
}

while read -r local_ref local_sha remote_ref remote_sha; do
  # Pushes to main (or anywhere else) are not deploys — let them through.
  [ "$remote_ref" = "$DEPLOY_REF" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion

  echo "pre-push: promoting to deploy — this publishes. Checking first."

  # --- 1. Preflight -------------------------------------------------
  # Every check in preflight encodes a defect that previously cost a
  # second deploy. It runs against the working tree; preflight itself
  # warns when that differs from what is committed.
  if [ -f scripts/preflight.mjs ]; then
    if ! node scripts/preflight.mjs; then
      echo >&2
      echo "pre-push: BLOCKED — preflight failed, so this promotion is not deployable." >&2
      echo "          Fix the failures above and promote again." >&2
      exit 1
    fi
  else
    echo "pre-push: scripts/preflight.mjs not found — skipping preflight."
  fi

  # --- 2. Version must increase over what is deployed ---------------
  new_version=$(version_at "$local_sha") || {
    echo "pre-push: cannot read APP_VERSION from $VERSION_FILE in the commit being pushed." >&2
    echo "          Restore  var APP_VERSION = '<major>.<minor>';  — the release stamp depends on it." >&2
    exit 1
  }

  if [ "$remote_sha" = "$ZERO" ]; then            # first ever deploy
    echo "pre-push: first deploy — version $new_version accepted."
    continue
  fi

  old_version=$(version_at "$remote_sha") || {
    # Unreadable remote side (shallow clone, pre-this-scheme history, object
    # not fetched). Warn rather than block: failing to *check* is not
    # evidence of a missing bump.
    echo "pre-push: could not read the deployed APP_VERSION — skipping the version check."
    continue
  }

  if ! version_gt "$new_version" "$old_version"; then
    echo "pre-push: BLOCKED — the version must increase on every deploy." >&2
    echo "          deploy is at $old_version; this promotion is $new_version." >&2
    echo >&2
    echo "          Write the changelog.js entry, then:" >&2
    echo "            npm run bump   (or npm run bump:major)" >&2
    echo "            git commit -am 'x.y — summary'" >&2
    echo "            git push origin main && git push origin main:deploy" >&2
    exit 1
  fi

  echo "pre-push: $old_version → $new_version — deploying."
done

exit 0
